# Copy to terraform.tfvars (gitignored) and fill in.

# The AWS account this stack deploys to. The provider refuses any other account.
aws_account_id = "123456789012"

alert_email = "alerts@example.com"

# The deploy role's trusted sub: the repo's immutable subject prefix, as GitHub
# reports it (GET repos/<owner>/<repo>/actions/oidc/customization/sub), plus main.
# Only a workflow running on main can assume the role; a branch, tag, pull
# request or environment gets a different sub.
github_oidc_sub = "repo:<owner>@<owner-id>/<repo>@<repo-id>:ref:refs/heads/main"
